#!/bin/bash

# simple standalone iotest for TablEdit import
# run mtest/tabledit/io directory as "./iotest"

# Linux
#MSCORE=../../../build.debug/mscore/mscore
MSCORE=../../../build.release/main/mscore
# OS X terminal build
#MSCORE=../../../applebuild/mscore.app/Contents/MacOS/mscore
# OS X Xcode build
#MSCORE=../../../build.xcode/mscore/Debug/mscore.app/Contents/MacOS/mscore
# OS X Xcode build (since early 2020)
#MSCORE=../../../build.xcode/main/Debug/mscore.app/Contents/MacOS/mscore

echo "---------------------------------------------"
echo "Regression Tests for MuseScore TablEdit import"
echo "---------------------------------------------"
echo
$MSCORE -v
echo

teffiles=`cat tst_tabledit_io.cpp | grep "{ tefReadTest" | awk -F\" '{print $2}' | sort`
testcount=0
failures=0

teftest() {
      echo -n "testing load/save $1$2";
      $MSCORE -t $1$2 -o  mops.mscx &> /dev/null
      if diff -q $1.ref.mscx mops.mscx &> /dev/null; then
            echo -e "\r\t\t\t\t\t\t...OK";
      else
            echo -e "\r\t\t\t\t\t\t...FAILED";
            failures=$(($failures+1));
            echo "+++++++++DIFF++++++++++++++"
            diff $1.ref.mscx mops.mscx
            echo "+++++++++++++++++++++++++++"
      fi
      rm mops.mscx
      testcount=$(($testcount+1))
      }

echo "TablEdit files ..."
for f in $teffiles; do
      teftest ${f} .tef
done

echo
echo "$testcount test(s), $failures failure(s)"
